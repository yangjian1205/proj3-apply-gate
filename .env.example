# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 屏蔽，绝不会入库。

# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=sk-在这里填你的key

# 接口地址（一般不用改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名
# 当前官方模型：deepseek-flash（DeepSeek-V4.1-Flash）
# 另一个可选：deepseek-v4-pro（更贵更强）
# ⚠️ 旧名 deepseek-chat 已不在官方价格表上，仍可调用但按 flash 计价
DEEPSEEK_MODEL=deepseek-flash

# 价格口径（元 / 百万 tokens），用于成本记账。
# 默认值来自 https://api-docs.deepseek.com/zh-cn/quick_start/pricing （2026-10-06 读取）
# 官方调价后改这里，不用改代码。不填就用 core/llm.py 里的内置表。
# DEEPSEEK_PRICE_OFFPEAK_INPUT=1
# DEEPSEEK_PRICE_OFFPEAK_OUTPUT=4
# DEEPSEEK_PRICE_PEAK_INPUT=2
# DEEPSEEK_PRICE_PEAK_OUTPUT=8
